      H -0.8858269 -0.0099074 3.7340662
      C -0.6098052 -0.0051706 2.6839376
      N -1.5660059 -0.0044593 1.6825133
      H -2.5739287 -0.0104122 1.7887665
      C 1.4519352 0.0039931 -0.2048012
