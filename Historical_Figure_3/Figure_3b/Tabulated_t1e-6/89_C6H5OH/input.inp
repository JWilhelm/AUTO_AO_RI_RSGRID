&GLOBAL
  PRINT_LEVEL LOW
  PROJECT gw100_89_C6H5OH_t1e-6
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      SCF_GUESS ATOMIC
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 7
        REGULARIZATION_MINIMAX 1.0E-6
        HEDIN_SHIFT F
        &RI_RS
          GRID_SELECT 1
          TIKHONOV 1.0E-4
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            RS_AO_RATIO 7
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 300
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 22 22 22
      PERIODIC NONE
    &END CELL
    &COORD
      C -1.046085 -0.892147 -0.000000
      C 0.257414 -1.400049 0.000000
      C 1.331097 -0.503372 -0.000000
      C 1.091601 0.874901 -0.000000
      C -0.121202 1.347367 0.000000
      C -1.230130 0.494536 0.000000
      H -1.874522 -1.578781 0.001032
      H 0.431625 -2.467932 0.001287
      H 2.336451 -0.886828 0.000832
      H 1.937051 1.553332 -0.000803
      O -0.312498 2.697885 -0.001272
      H -2.244385 0.877082 -0.000405
      H -1.251130 2.879281 -0.002039
    &END COORD
    &KIND C
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_050_s_p_d_f_g_h_i_6_5_3_2_0_0_0_error_6.3e-07
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
