      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_011_s_p_d_f_g_h_i_5_2_0_0_0_0_0_error_8.5e-07
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_055_s_p_d_f_g_h_i_6_5_4_2_0_0_0_error_5.9e-07
      POTENTIAL GTH-PBE
