&GLOBAL
  PRINT_LEVEL LOW
  PROJECT gw100_106_96_uracil_a5_leb_r06
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      SCF_GUESS ATOMIC
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 7
        REGULARIZATION_MINIMAX 1.0E-6
        HEDIN_SHIFT F
        &AUTO_RI
          RI_AO_RATIO 5
        &END AUTO_RI
        &RI_RS
          GRID_SELECT 1
          TIKHONOV 1.0E-4
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            INITIAL_GRID CHOLESKY
            CHOLESKY_MATRIX D_PRIME
            CHOLESKY_CANDIDATE_DOMAIN FULL_ATOM
            RADIAL_QUADRATURE GAPW_LOG
            RS_AO_RATIO_INITIAL 30
            L_ADDITIONAL 2
            RS_AO_RATIO 6
            CUTOFF_ATOMIC_CLUSTER [angstrom] 5.0
            MAX_ITER 300
            LBFGS_HISTORY 7
            LBFGS_FACTR 0.0
            LBFGS_PGTOL 1.0E-9
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 21 21 21
      PERIODIC NONE
    &END CELL
    &COORD
      H 1.7181113 -0.0000002 -2.1244327
      C 1.1438667 -0.0000001 -1.2038069
      C 1.7446080 -0.0000000 0.0097511
      H 2.8271212 -0.0000001 0.1298240
      C -0.3090145 0.0000000 -1.2970091
      O -0.9725128 -0.0000001 -2.3249912
      N -0.9523747 0.0000001 -0.0343227
      H -1.9701793 0.0000002 -0.0511160
      C -0.3751368 0.0000001 1.2248796
      O -0.9991833 -0.0000001 2.2733353
      N 1.0223980 0.0000001 1.1766034
      H 1.4813173 0.0000001 2.0806653
    &END COORD
    &KIND C
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_115_s_p_d_f_g_h_i_7_6_6_6_2_0_0_error_6.7e-09
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_050_s_p_d_f_g_h_i_7_6_5_0_0_0_0_error_2.6e-09
      POTENTIAL GTH-PBE
    &END KIND
    &KIND N
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_097_s_p_d_f_g_h_i_7_6_6_6_0_0_0_error_2.7e-09
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_097_s_p_d_f_g_h_i_7_6_6_6_0_0_0_error_6.8e-09
      POTENTIAL GTH-PBE
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
