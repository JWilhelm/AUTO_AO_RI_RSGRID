&GLOBAL
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  PROJECT gw129g_030_d1
&END GLOBAL


&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/followups/pbe_g0w0/gw100/30_C5H6/dzvp_t1/BASIS_SELECTED
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
      &MULTIPOLE
        &PROGRAM_RUN_INFO OFF
        &END PROGRAM_RUN_INFO
      &END MULTIPOLE
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 6
        &AUTO_RI
          RI_AO_RATIO 4
          OCC_EMPTY_FRONTIER_ORBITAL_WINDOW [eV] 5
          NEIGHBOR_RADIUS [angstrom] 3
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-8
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 300
            RS_AO_RATIO 7
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 21 21 21
      PERIODIC NONE
    &END CELL
    &COORD
      C 0.735000 0.000000 0.000000
      C -0.735000 0.000000 0.000000
      C 1.180760 0.000000 1.265805
      C -1.180760 0.000000 1.265805
      C -0.003091 0.000000 2.209296
      H 2.228506 0.000000 1.566354
      H 1.364644 0.000000 -0.889746
      H -1.364960 0.000000 -0.889523
      H -2.228838 0.000000 1.565193
      H -0.001086 0.885447 2.844969
      H -0.005702 -0.882815 2.848618
    &END COORD
    &KIND C
      BASIS_SET AUG-DZVP-MOLOPT-GTH-TIER-1_1
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-GTH-tier-1_N_RI_106_s_p_d_f_g_h_i_7_6_6_6_1_0_0_error_3.2e-08
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
      BASIS_SET AUG-DZVP-MOLOPT-GTH-TIER-2_1
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-GTH-tier-2_N_RI_055_s_p_d_f_g_h_i_7_6_6_0_0_0_0_error_6.8e-09
      POTENTIAL GTH-PBE
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
