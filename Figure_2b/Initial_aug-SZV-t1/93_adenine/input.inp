&GLOBAL
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  PROJECT f1i_093_s1
&END GLOBAL


&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
      &MULTIPOLE
        &PROGRAM_RUN_INFO OFF
        &END PROGRAM_RUN_INFO
      &END MULTIPOLE
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 6
        &AUTO_RI
          RI_AO_RATIO 4
          OCC_EMPTY_FRONTIER_ORBITAL_WINDOW [eV] 5
          NEIGHBOR_RADIUS [angstrom] 3
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-8
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 300
            RS_AO_RATIO 7
          &END GRID_OPTIMIZATION
        &END RI_RS
        &PRINT
          &RESTART OFF
          &END RESTART
        &END PRINT
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 23 23 23
      PERIODIC NONE
    &END CELL
    &COORD
      C -0.7843450 0.0024660 0.6854944
      C 0.5301823 0.0009168 0.1951947
      N -1.9138024 0.0022584 -0.0334730
      C -1.6479109 -0.0019330 -1.3472026
      H -2.5169904 -0.0044917 -2.0095241
      N -0.4540095 -0.0051210 -1.9657824
      C 0.6617763 -0.0009654 -1.2107858
      N 1.8686255 0.0181736 -1.8266445
      H 2.7131398 -0.0801668 -1.2801876
      H 1.9011412 -0.0813319 -2.8324875
      N 1.4556976 -0.0028403 1.2254693
      H 1.1016503 -0.0046108 3.3314279
      C 0.7173645 -0.0023279 2.3155892
      N -0.6380338 0.0012265 2.0572467
      H -1.3931273 0.0022322 2.7328517
    &END COORD
    &KIND C
      POTENTIAL GTH-PBE
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-1
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-1_N_RI_050_s_p_d_f_g_h_i_7_6_5_0_0_0_0_error_4.1e-07
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-1
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-1_N_RI_055_s_p_d_f_g_h_i_7_6_6_0_0_0_0_error_1.1e-09
    &END KIND
    &KIND N
      POTENTIAL GTH-PBE
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-1
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-1_N_RI_055_s_p_d_f_g_h_i_7_6_6_0_0_0_0_error_5.8e-08
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
