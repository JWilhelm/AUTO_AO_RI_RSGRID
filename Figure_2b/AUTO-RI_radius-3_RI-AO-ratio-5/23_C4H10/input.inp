&GLOBAL
  PRINT_LEVEL LOW
  PROJECT gw100_23_C4H10_rc3_a5
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
