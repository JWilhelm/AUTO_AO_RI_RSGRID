    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-15
        CUTOFF_RADIUS_RI [angstrom] 7
        REGULARIZATION_MINIMAX 1.0E-6
