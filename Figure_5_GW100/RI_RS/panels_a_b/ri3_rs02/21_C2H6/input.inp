&GLOBAL
  PRINT_LEVEL LOW
  PROJECT g418_a302_m021
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/148_Figure4_augDZVP_T2_metdyn/repository/GW100_SCF_WFN_POOL/021_C2H6/gw100_scf_m021-RESTART.wfn
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/148_Figure4_augDZVP_T2_metdyn/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/148_Figure4_augDZVP_T2_metdyn/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/148_Figure4_augDZVP_T2_metdyn/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      SCF_GUESS RESTART
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_KINETIC
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-12
        CUTOFF_RADIUS_RI [angstrom] 7
        REGULARIZATION_MINIMAX 1.0E-6
        HEDIN_SHIFT F
        &AUTO_RI
          RI_AO_RATIO 3
        &END AUTO_RI
        &RI_RS
          GRID_SELECT 1
          TIKHONOV 1.0E-4
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            RS_AO_RATIO 2
            CUTOFF_ATOMIC_CLUSTER [angstrom] 0.5
            MAX_ITER 300
          &END GRID_OPTIMIZATION
        &END RI_RS
        &PRINT
          &RESTART OFF
          &END RESTART
        &END PRINT
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 20 20 20
      PERIODIC NONE
    &END CELL
    &COORD
      C 0.000100 0.765700 0.000000
      C -0.000100 -0.769300 0.000000
      H -0.134892 1.160801 -1.011192
      H -0.808178 1.160889 0.622373
      H 0.943359 1.160660 0.388723
      H 0.808348 -1.164489 -0.622151
      H 0.134598 -1.164401 1.011231
      H -0.943239 -1.164260 -0.389014
    &END COORD
    &KIND C
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-GTH-tier-2_N_RI_109_s_p_d_f_g_h_i_7_6_5_3_3_1_0_error_6.0e-07
      POTENTIAL GTH-PBE
    &END KIND
    &KIND H
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-GTH-tier-2_N_RI_055_s_p_d_f_g_h_i_7_6_6_0_0_0_0_error_6.8e-09
      POTENTIAL GTH-PBE
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
