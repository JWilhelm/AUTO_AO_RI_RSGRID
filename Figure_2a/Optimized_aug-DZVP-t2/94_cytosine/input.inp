      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 6
        &AUTO_RI
