&GLOBAL
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  PROJECT gw129g_011_s2
&END GLOBAL


&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/followups/pbe_g0w0/gw100/11_K2/szv_t2/BASIS_SELECTED
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/097_GW100_GTH_augSZV_T2_grid_shift/assets/BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/53_benchmark_RI_opt/129_GW100_Si293_AO_frontier_optimization_coopfst/assets/GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
      &MULTIPOLE
        &PROGRAM_RUN_INFO OFF
        &END PROGRAM_RUN_INFO
      &END MULTIPOLE
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-7
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 6
        &AUTO_RI
          RI_AO_RATIO 4
          OCC_EMPTY_FRONTIER_ORBITAL_WINDOW [eV] 5
          NEIGHBOR_RADIUS [angstrom] 3
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-8
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 300
            RS_AO_RATIO 7
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 20 20 20
      PERIODIC NONE
    &END CELL
    &COORD
      K 0.0000 0.0000 0.0000
      K 0.0000 0.0000 3.9051
    &END COORD
    &KIND K
      BASIS_SET AUG-SZV-MOLOPT-GTH-TIER-2_5
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_115_s_p_d_f_g_h_i_7_6_6_6_2_0_0_error_2.2e-07
      POTENTIAL GTH-PBE
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
