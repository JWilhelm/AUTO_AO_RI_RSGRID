&FORCE_EVAL
  METHOD Quickstep
  &DFT
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/05_Benchmark_RI_opt/gw100_qzvp_fig6_otus_20261017/payload/511_GW100_PBE_def2QZVP_RS6to10_20261014/rs6/calculations/94_cytosine/ALL_ELEC-RESTART.wfn
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/05_Benchmark_RI_opt/gw100_qzvp_fig6_otus_20261017/payload/510_GW100_PBE_def2QZVP_RS5_20261013/source/data/BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/05_Benchmark_RI_opt/gw100_qzvp_fig6_otus_20261017/payload/510_GW100_PBE_def2QZVP_RS5_20261013/source/data/POTENTIAL
    &MGRID
      CUTOFF 800
      REL_CUTOFF 80
    &END MGRID
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-14
      EPS_PGF_ORB 1.0E-14
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER WAVELET
    &END POISSON
    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 300
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        ENERGIES
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 34
        EPS_FILTER 1.0E-20
        FREQ_MAX_FIT [eV] 10
        CUTOFF_RADIUS_RI [angstrom] 11
        &RI_RS
          TIKHONOV 1.0E-5
          &GRID_OPTIMIZATION
            RS_AO_RATIO 12
            CUTOFF_ATOMIC_CLUSTER [angstrom] 5
            MAX_ITER 100
          &END GRID_OPTIMIZATION
        &END RI_RS
        &PRINT
          &RESTART OFF
          &END RESTART
        &END PRINT
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 27 27 27
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/05_Benchmark_RI_opt/gw100_qzvp_fig6_otus_20261017/payload/511_GW100_PBE_def2QZVP_RS6to10_20261014/rs6/calculations/94_cytosine/94_cytosine.xyz
      COORD_FILE_FORMAT xyz
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND H
      BASIS_SET def2-QZVP
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND C
      BASIS_SET def2-QZVP
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET def2-QZVP
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET def2-QZVP
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      ALL_ELEC
  PRINT_LEVEL  MEDIUM
&END GLOBAL
