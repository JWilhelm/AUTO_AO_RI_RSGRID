      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_097_s_p_d_f_g_h_i_7_6_6_6_0_0_0_error_2.7e-09
      POTENTIAL GTH-PBE
