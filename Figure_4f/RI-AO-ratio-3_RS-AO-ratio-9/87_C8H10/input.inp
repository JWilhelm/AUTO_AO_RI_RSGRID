&GLOBAL
  PRINT_LEVEL LOW
  PROJECT gw100_106_87_C8H10_a3_leb_r09
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
