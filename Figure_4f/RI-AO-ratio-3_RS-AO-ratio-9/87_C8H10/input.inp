        MAX_SCF 20
      &END OUTER_SCF
    &END SCF
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 30
        EPS_FILTER 1.0E-7
        CUTOFF_RADIUS_RI [angstrom] 7
        REGULARIZATION_MINIMAX 1.0E-6
        HEDIN_SHIFT F
        &AUTO_RI
          RI_AO_RATIO 3
        &END AUTO_RI
        &RI_RS
          GRID_SELECT 1
          TIKHONOV 1.0E-4
          CUTOFF_RADIUS_RL_AO [angstrom] 8
          N_PROCS_PER_ATOM_Z_LP -1
          &GRID_OPTIMIZATION
            INITIAL_GRID CHOLESKY
            CHOLESKY_MATRIX D_PRIME
            CHOLESKY_CANDIDATE_DOMAIN FULL_ATOM
            RADIAL_QUADRATURE GAPW_LOG
            RS_AO_RATIO_INITIAL 30
            L_ADDITIONAL 2
            RS_AO_RATIO 9
            CUTOFF_ATOMIC_CLUSTER [angstrom] 5.0
            MAX_ITER 300
            LBFGS_HISTORY 7
            LBFGS_FACTR 0.0
            LBFGS_PGTOL 1.0E-9
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 24 24 24
      PERIODIC NONE
    &END CELL
    &COORD
      C -2.2693535 -0.0000389 -0.2398724
