&GLOBAL
  PRINT_LEVEL LOW
  PROJECT gw100_122_86_C7H8_riao5_r09
  RUN_TYPE ENERGY
  &TIMINGS
    THRESHOLD 0.001
    REPORT_MAXLOC T
  &END TIMINGS
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
